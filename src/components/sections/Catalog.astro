---
import SectionHead from "../SectionHead.astro";
import ModelCard from "../ModelCard.astro";
import { models, modelFilters, stats, pricesUpdated } from "../../lib/catalog.js";
---

<section id="models">
  <div class="wrap">
    <SectionHead
      kicker="The catalog"
      title="A model for every job."
      sub={`${stats.modelCount} models with real prices per 1M tokens. Every card shows what to use it for and when to skip it.`}
    />
    <div class="filter-row">
      {
        modelFilters.map((filter, index) => (
          <button
            class:list={["chip", { active: index === 0 }]}
            type="button"
            data-filter={filter.id}
          >
            {filter.label}
          </button>
        ))
      }
    </div>
    <div class="grid grid-3">
      {models.map((model) => <ModelCard model={model} />)}
    </div>
    <p class="hint" style="margin-top: 1.5rem">
      Prices updated {pricesUpdated} · Source: models.dev. "Use for" and "Skip
      for" are editorial; prices and limits are live.
    </p>
  </div>
</section>

<script>
  import { initFilters } from "../../scripts/filters.js";
  initFilters();
</script>
