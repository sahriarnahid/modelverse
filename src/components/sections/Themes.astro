---
import SectionHead from "../SectionHead.astro";
import { themes } from "../../data/themes.js";
---

<section id="themes">
  <div class="wrap">
    <SectionHead
      kicker="Make it yours"
      title="Pick a theme, change everything."
      sub={`${themes.length} themes restyle the whole site at once. Click one, or press T to flip through them.`}
    />
    <div class="theme-grid">
      {
        themes.map((theme) => (
          <button class="theme-pill" type="button" data-theme-link={theme.id}>
            <span
              class="swatch"
              style={`background: ${theme.bg}; box-shadow: inset 0 0 0 3px ${theme.brand}`}
            />
            {theme.name}
          </button>
        ))
      }
    </div>
    <p class="hint" style="margin-top: 1.25rem">
      Your choice is saved in this browser. Try <kbd>T</kbd> right now.
    </p>
  </div>
</section>
