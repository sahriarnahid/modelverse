---
import Logo from "./Logo.astro";

const links = [
  { href: "#models", label: "Models" },
  { href: "#compare", label: "Compare" },
  { href: "#market", label: "Market" },
  { href: "#agents", label: "Agents" },
  { href: "#themes", label: "Themes" },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="#top">
      <Logo />
      ModelVerse
    </a>
    <nav class="site-nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="theme-cycle" type="button" data-theme-cycle>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="13.5" cy="6.5" r="0.5"></circle>
          <circle cx="17.5" cy="10.5" r="0.5"></circle>
          <circle cx="8.5" cy="7.5" r="0.5"></circle>
          <circle cx="6.5" cy="12.5" r="0.5"></circle>
          <path
            d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
          ></path>
        </svg>
        Change the theme
      </button>
      <a class="btn btn-primary btn-sm" href="#stacks">
        Get started
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <button class="nav-toggle" type="button" data-nav-toggle aria-label="Toggle menu">
        Menu
      </button>
    </div>
  </div>
</header>
