---
const { class: className = "logo-mark" } = Astro.props;

const pixels = [
  [0, 0],
  [5, 0],
  [0, 1],
  [1, 1],
  [4, 1],
  [5, 1],
  [0, 2],
  [2, 2],
  [3, 2],
  [5, 2],
  [0, 3],
  [5, 3],
  [0, 4],
  [5, 4],
];
---

<svg
  class={className}
  width="24"
  height="20"
  viewBox="0 0 24 20"
  fill="none"
  aria-hidden="true"
>
  {
    pixels.map(([x, y]) => (
      <rect
        x={x * 4}
        y={y * 4}
        width="3.5"
        height="3.5"
        fill="var(--t-brand)"
      />
    ))
  }
</svg>
